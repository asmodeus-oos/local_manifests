<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- GitLab remote -->
  <remote name="gitlab"
          fetch="https://gitlab.com/" />

  <!-- Remove ROM default projects we want to replace -->
  <remove-project name="LineageOS/android_vendor_qcom_opensource_agm" />
  <remove-project name="LineageOS/android_hardware_qcom_display" />

  <!-- Device -->
  <project path="device/realme/ferrari"
           name="asmodeus-oos/android_device_realme_ferrari"
           remote="github"
           revision="lineage-23.2" />

  <project path="device/oneplus/sm8450-common"
           name="asmodeus-oos/android_device_oneplus_sm8450-common"
           remote="github"
           revision="lineage-23.2" />

  <!-- Vendor -->
  <project path="vendor/realme/ferrari"
           name="asmodeus-oos/proprietary_vendor_realme_ferrari"
           remote="gitlab"
           revision="lineage-23.2" />

  <project path="vendor/oneplus/sm8450-common"
           name="asmodeus-oos/proprietary_vendor_oneplus_sm8450-common"
           remote="gitlab"
           revision="lineage-23.2" />

  <!-- Afterlife private keys -->
  <project path="vendor/afterlife/priv_keys"
           name="asmodeus-oos/android_vendor_afterlife-priv_keys"
           remote="github"
           revision="afterlife" />

  <!-- Kernel -->
  <project path="kernel/oneplus/sm8450"
           name="asmodeus-oos/android_kernel_oneplus_sm8450"
           remote="github"
           revision="lineage-23.2" />

  <project path="kernel/oneplus/sm8450-modules"
           name="asmodeus-oos/android_kernel_oneplus_sm8450-modules"
           remote="github"
           revision="lineage-23.2" />

  <project path="kernel/oneplus/sm8450-devicetrees"
           name="asmodeus-oos/android_kernel_oneplus_sm8450-devicetrees"
           remote="github"
           revision="lineage-23.2" />

  <!-- Hardware -->
  <project path="hardware/oplus"
           name="asmodeus-oos/android_hardware_oplus"
           remote="github"
           revision="lineage-23.2" />

  <!-- Replace AGM audio -->
  <project path="hardware/qcom-caf/sm8450/audio/agm"
           name="asmodeus-oos/android_vendor_qcom_opensource_agm"
           remote="github"
           revision="lineage-23.2-caf-sm8450" />

  <!-- Replace QCOM display -->
  <project path="hardware/qcom-caf/sm8450/display"
           name="asmodeus-oos/android_hardware_qcom_display"
           remote="github"
           revision="lineage-23.2-caf-sm8450" />

</manifest>