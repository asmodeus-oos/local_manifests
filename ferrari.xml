  <project path="hardware/lineage/compat"
           name="android_hardware_lineage_compat"
           remote="asmodeus"
           revision="17.0" />

  <project path="frameworks/base"
           name="android_frameworks_base"
           remote="asmodeus"
           revision="17.0" />

  <project path="frameworks/av"
           name="android_frameworks_av"
           remote="asmodeus"
           revision="17.0" />

  <project path="frameworks/native"
           name="android_frameworks_native"
           remote="asmodeus"
           revision="17.0" />

  <project path="frameworks/libs/systemui"
           name="android_frameworks_libs_systemui"
           remote="asmodeus"
           revision="17.0" />

</manifest>
