<?xml version="1.0" encoding="UTF-8"?>
<!--
     Local manifest for Realme GT 2 Pro (ferrari / RMX3301)
     Evolution X 12.3 (Android 17.0)

     Usage:
       1. Clone this repository into .repo/local_manifests:
            git clone https://github.com/asmodeus-oos/android_local_manifests.git -b 17.0 .repo/local_manifests
       2. Sync sources:
            repo sync -c -j$(nproc --all) --force-sync --no-clone-bundle --no-tags
-->

<manifest>

  <!-- Remotes -->
  <remote name="asmodeus"
          fetch="https://github.com/asmodeus-oos"
          revision="17.0" />

  <!-- Remove upstream projects to replace with patched forks -->
  <remove-project name="frameworks_av" />
  <remove-project name="frameworks_base" />
  <remove-project name="frameworks_libs_systemui" />
  <remove-project name="frameworks_native" />
  <remove-project name="hardware_lineage_compat" />
  <remove-project name="packages_apps_Evolver" />
  <remove-project name="packages_apps_Settings" />
  <remove-project name="vendor_evolution" />
  <remove-project name="LineageOS/android_hardware_qcom_display" />
  <remove-project name="LineageOS/android_hardware_qcom_audio-ar" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_agm" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_arpal-lx" />
  <remove-project name="LineageOS/android_hardware_qcom_thermal" />

  <!-- Device Trees -->
  <project path="device/realme/ferrari"
           name="android_device_realme_ferrari"
           remote="asmodeus"
           revision="17.0" />

  <project path="device/oneplus/sm8450-common"
           name="android_device_oneplus_sm8450-common"
           remote="asmodeus"
           revision="17.0" />

  <!-- Hardware HALs -->
  <project path="hardware/oplus"
           name="android_hardware_oplus"
           remote="asmodeus"
           revision="17.0" />

  <!-- Kernel Source, Devicetrees and Modules -->
  <project path="kernel/oneplus/sm8450"
           name="android_kernel_oneplus_sm8450"
           remote="asmodeus"
           revision="17.0" />

  <project path="kernel/oneplus/sm8450-devicetrees"
           name="android_kernel_oneplus_sm8450-devicetrees"
           remote="asmodeus"
           revision="17.0" />

  <project path="kernel/oneplus/sm8450-modules"
           name="android_kernel_oneplus_sm8450-modules"
           remote="asmodeus"
           revision="17.0" />

  <!-- Qualcomm Display HAL (sm8450 and sm8450-6.6) -->
  <project path="hardware/qcom-caf/sm8450/display"
           name="android_hardware_qcom_display"
           remote="asmodeus"
           revision="lineage-24.0-caf-sm8450" />

  <project path="hardware/qcom-caf/sm8450-6.6/display/hal"
           name="android_hardware_qcom_display"
           remote="asmodeus"
           revision="lineage-24.0-caf-sm8450-6.6" />

  <!-- Qualcomm Audio HALs (sm8450 and sm8450-6.6) -->
  <project path="hardware/qcom-caf/sm8450/audio/primary-hal"
           name="android_hardware_qcom_audio-ar"
           remote="asmodeus"
           revision="lineage-24.0-caf-sm8450" />

  <project path="hardware/qcom-caf/sm8450-6.6/audio/primary-hal"
           name="android_hardware_qcom_audio-ar"
           remote="asmodeus"
           revision="lineage-24.0-caf-sm8450-6.6" />

  <project path="hardware/qcom-caf/sm8450/audio/agm"
           name="android_vendor_qcom_opensource_agm"
           remote="asmodeus"
           revision="lineage-24.0-caf-sm8450" />

  <project path="hardware/qcom-caf/sm8450-6.6/audio/agm"
           name="android_vendor_qcom_opensource_agm"
           remote="asmodeus"
           revision="lineage-24.0-caf-sm8450-6.6" />

  <project path="hardware/qcom-caf/sm8450/audio/pal"
           name="android_vendor_qcom_opensource_arpal-lx"
           remote="asmodeus"
           revision="lineage-24.0-caf-sm8450" />

  <project path="hardware/qcom-caf/sm8450-6.6/audio/pal"
           name="android_vendor_qcom_opensource_arpal-lx"
           remote="asmodeus"
           revision="lineage-24.0-caf-sm8450-6.6" />

  <!-- Qualcomm Thermal HAL -->
  <project path="hardware/qcom-caf/thermal"
           name="android_hardware_qcom_thermal"
           remote="asmodeus"
           revision="17.0" />

  <!-- Evolution X Patched Sources -->
  <project path="packages/apps/Evolver"
           name="android_packages_apps_Evolver"
           remote="asmodeus"
           revision="17.0" />

  <project path="packages/apps/Settings"
           name="android_packages_apps_Settings"
           remote="asmodeus"
           revision="17.0" />

  <project path="vendor/lineage"
           name="android_vendor_evolution"
           remote="asmodeus"
