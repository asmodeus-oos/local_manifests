<?xml version="1.0" encoding="UTF-8"?>
<!--
     Local manifest for Realme GT2 Pro (ferrari / RMX3301)
     Qualcomm SM8450 (Snapdragon 8 Gen 1) - LineageOS 23.3

     Usage:
       1. Place this file in .repo/local_manifests/ferrari.xml
       2. repo sync -c -j4
       3. bash device/realme/ferrari/patches/apply-patches.sh
-->
<manifest>

  <!-- Remotes -->
  <remote name="github-asmodeus"
          fetch="https://github.com/asmodeus-oos"
          revision="17.0" />

  <remote name="gitlab-asmodeus"
          fetch="https://gitlab.com/asmodeus-oos"
          revision="lineage-23.2" />

  <remote name="bubundas17"
          fetch="https://github.com/bubundas17" />

  <!-- Device Trees -->
  <project path="device/realme/ferrari"
           name="android_device_realme_ferrari"
           remote="github-asmodeus"
           revision="17.0" />

  <project path="device/oneplus/sm8450-common"
           name="android_device_oneplus_sm8450-common"
           remote="github-asmodeus"
           revision="17.0" />

  <!-- Hardware HALs -->
  <project path="hardware/oplus"
           name="android_hardware_oplus"
           remote="github-asmodeus"
           revision="17.0" />

  <!-- Oplus Camera -->
  <project path="vendor/oplus/camera"
           name="vendor_oplus_camera"
           remote="github-asmodeus"
           revision="17.0" />

  <!-- Kernel Source and Modules (Linux 5.10.260) -->
  <project path="kernel/oneplus/sm8450"
           name="android_kernel_oneplus_sm8450"
           remote="github-asmodeus"
           revision="17.0" />

  <project path="kernel/oneplus/sm8450-devicetrees"
           name="android_kernel_oneplus_sm8450-devicetrees"
           remote="github-asmodeus"
           revision="17.0" />

  <project path="kernel/oneplus/sm8450-modules"
           name="android_kernel_oneplus_sm8450-modules"
           remote="github-asmodeus"
           revision="17.0" />

  <!-- Vendor Blobs (GitLab, lineage-23.2) -->
  <project path="vendor/realme/ferrari"
           name="proprietary_vendor_realme_ferrari"
           remote="gitlab-asmodeus"
           revision="lineage-23.2" />

  <project path="vendor/oneplus/sm8450-common"
           name="proprietary_vendor_oneplus_sm8450-common"
           remote="gitlab-asmodeus"
           revision="lineage-23.2" />

  <!-- Signing Keys -->
  <project path="vendor/lineage-priv/keys"
           name="android_vendor_lineage-priv_keys"
           remote="github-asmodeus"
           revision="master" />

  <!-- Overrides for ROM source HALs -->
  <extend-project path="hardware/qcom-caf/sm8450/display"
                  name="hardware_qcom_display"
                  remote="bubundas17"
                  revision="ferrari-fixes" />

  <extend-project path="hardware/qcom-caf/sm8450/audio/agm"
                  name="android_vendor_qcom_opensource_agm"
                  remote="bubundas17"
                  revision="ferrari-fixes-sm8450" />

  <extend-project path="hardware/qcom-caf/sm8450-6.6/audio/agm"
                  name="android_vendor_qcom_opensource_agm"
                  remote="bubundas17"
                  revision="ferrari-fixes-sm8450-6.6" />

</manifest>
